<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A080A"
    tools:context=".MainActivity">

    <!-- 1. Background Image (Modular: User can replace drawable or supply custom bitmap in future) -->
    <ImageView
        android:id="@+id/main_background_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/god_hand_bg"
        android:contentDescription="God Hand Menu Background" />

    <!-- 2. Subtle Dark Vignette Overlay for High Contrast Text & Buttons -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#40000000" />

    <!-- 3. Centered Main Menu Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Title Area (Modular: User can swap with custom Logo Image in future) -->
        <LinearLayout
            android:id="@+id/god_hand_title_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <!-- Future Custom Title Picture Slot -->
            <ImageView
                android:id="@+id/god_hand_title_logo"
                android:layout_width="wrap_content"
                android:layout_height="120dp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:visibility="gone"
                android:contentDescription="God Hand Custom Title Logo" />

            <!-- Default Stylized Typography Banner -->
            <TextView
                android:id="@+id/god_hand_title_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:shadowColor="#DC2626"
                android:shadowDx="3"
                android:shadowDy="4"
                android:shadowRadius="10"
                android:text="GOD HAND"
                android:textColor="#F59E0B"
                android:textSize="50sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/god_hand_subtitle_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:letterSpacing="0.2"
                android:text="PS2 STATIC RECOMPILATION • ARM64"
                android:textColor="#D4AF37"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Menu Action Options (PLAY, SETTINGS, QUIT) -->
        <LinearLayout
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="vertical">

            <!-- 1. PLAY BUTTON -->
            <Button
                android:id="@+id/btn_menu_play"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:background="@drawable/btn_god_hand_primary"
                android:letterSpacing="0.1"
                android:text="⚔   P L A Y"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <!-- 2. SETTINGS BUTTON -->
            <Button
                android:id="@+id/btn_menu_settings"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/btn_god_hand_secondary"
                android:letterSpacing="0.08"
                android:text="⚙   S E T T I N G S"
                android:textColor="#FDE047"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- 3. QUIT BUTTON -->
            <Button
                android:id="@+id/btn_menu_quit"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/btn_god_hand_secondary"
                android:letterSpacing="0.08"
                android:text="✕   Q U I T"
                android:textColor="#E2E8F0"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

    <!-- 4. Subtle Bottom Footprint / SoC Badge -->
    <TextView
        android:id="@+id/tv_bottom_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="12dp"
        android:alpha="0.75"
        android:letterSpacing="0.05"
        android:text="Vulkan PCSX2-GS Engine • 60 FPS Authenticated"
        android:textColor="#94A3B8"
        android:textSize="11sp" />

</FrameLayout>