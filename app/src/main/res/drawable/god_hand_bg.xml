<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Matte obsidian base canvas -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="85%p"
                android:centerX="50%"
                android:centerY="42%"
                android:startColor="#171418"
                android:centerColor="#0C0C10"
                android:endColor="#070709" />
        </shape>
    </item>
    <!-- Subtle minimalist God Hand crimson/gold top glow -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#1EB91C1C"
                android:centerColor="#00000000"
                android:endColor="#40000000" />
        </shape>
    </item>
</layer-list>
