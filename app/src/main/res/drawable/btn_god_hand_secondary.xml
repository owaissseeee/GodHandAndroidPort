<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#B45309"
                android:endColor="#78350F" />
            <stroke
                android:width="2.5dp"
                android:color="#FDE047" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <!-- Default state: dark obsidian leather with brass gold rim -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#261E1A"
                android:endColor="#141012" />
            <stroke
                android:width="1.8dp"
                android:color="#C8963E" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
